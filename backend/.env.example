# Porta do servidor
PORT=3001

# Conexão MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pizzaria_porteira

# Origem permitida para CORS (URL do front-end)
CORS_ORIGIN=http://localhost:5273

# Autenticação do painel admin
ADMIN_USER=admin
# Gere um hash com: node -e "console.log(require('bcryptjs').hashSync('SUA_SENHA', 10))"
ADMIN_PASSWORD_HASH=
JWT_SECRET=troque-este-valor-por-um-segredo-aleatorio-grande

# Pagamento PIX via Mercado Pago
# Crie uma conta em mercadopago.com.br -> Seu negócio -> Credenciais -> pegue o
# "Access Token" (use o de teste primeiro, começa com TEST-; o de produção começa com APP_USR-)
MP_ACCESS_TOKEN=
# Opcional: só necessário em produção, com o servidor acessível publicamente,
# para receber a confirmação do pagamento via webhook em vez de depender só do polling.
# Ex: https://seu-dominio.com/api/pagamentos/webhook
MP_NOTIFICATION_URL=

# Envio de promoções por e-mail (SMTP). Funciona com Gmail (use uma "senha de app"), Brevo,
# Resend, Mailgun etc. Sem isso, o servidor sobe normalmente e só o envio de campanhas fica indisponível.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Remetente exibido no e-mail. Ex: Pizzaria Porteira <contato@seudominio.com>
SMTP_FROM=
# Endereço público da API, usado no link de descadastro dentro dos e-mails (em produção, o domínio real)
PUBLIC_API_URL=http://localhost:3001

# Quantos proxies confiar ao descobrir o IP do cliente (usado pelos limitadores de taxa).
# Padrão 1 = atrás do proxy do Render. Use 0 se o servidor ficar exposto direto na internet.
TRUST_PROXY=1
